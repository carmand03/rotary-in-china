{
  "properties": {
    "genre": {
      "type": "string",
      "enum": [
        "correspondence",
        "roster",
        "report",
        "news_clipping",
        "regulations",
        "pamphlet",
        "periodical",
        "certificate",
        "administrative_record",
        "other"
      ]
    },
    "dates": {
      "default": [],
      "items": {
        "properties": {
          "type": {
            "description": "produced = written/sent/issued; received = e.g. receipt stamp; modified = e.g. date an excerpt or copy was made; other = any other date role",
            "enum": [
              "produced",
              "received",
              "modified",
              "other"
            ],
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "ISO date; truncate to YYYY-MM or YYYY if day/month unknown"
          },
          "as_written": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "the date exactly as it appears on the page"
          },
          "certainty": {
            "default": "certain",
            "enum": [
              "certain",
              "uncertain"
            ],
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "place_origin": {
      "description": "A value plus how sure we are: lets 'not specified / not applicable / uncertain' be queried.",
